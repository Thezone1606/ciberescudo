# Copia este archivo a infra/.env y completa los valores. No lo subas al repositorio.

# Nombre con el que se accede (debe coincidir con el certificado). Para una prueba local: localhost
SERVER_NAME=ciberescudo.local
HTTP_PORT=80
HTTPS_PORT=443

# Base de datos. Usa una contraseña solo con letras y números (por ejemplo: openssl rand -hex 24)
POSTGRES_DB=dsi_cyber
POSTGRES_USER=dsi
POSTGRES_PASSWORD=

# Claves de firma de sesiones: dos valores DISTINTOS y largos (por ejemplo: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Opcional: cargar usuarios de prueba (colaborador, analista y SecOps). Déjalo en false en producción.
SEED_DEMO_USERS=false
SEED_PASSWORD=
