generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Track {
  AWARENESS
  TECHNICAL
}

// Fase en la que se hizo un intento. PRACTICE es el juego normal; BASELINE y POSTTEST son el diagnóstico
// inicial y la evaluación final del piloto (no afectan XP, escudo ni racha).
enum AttemptPhase {
  PRACTICE
  BASELINE
  POSTTEST
}

enum Difficulty {
  BASIC
  INTERMEDIATE
  ADVANCED
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  users     User[]

  @@map("departments")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  departmentId     String    @map("department_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  fullName         String    @map("full_name") @db.VarChar(150)
  currentXp        Int       @default(0) @map("current_xp")
  currentStreak    Int       @default(0) @map("current_streak")
  shieldIntegrity  Int       @default(100) @map("shield_integrity")
  tokenVersion     Int       @default(0) @map("token_version")
  cooldownUntil    DateTime? @map("cooldown_until") @db.Timestamptz
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  attempts      Attempt[]
  refreshTokens RefreshToken[]
  susResponse   SusResponse?

  @@index([departmentId], map: "idx_users_department")
  @@map("users")
}

model Category {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(100)
  description String?
  challenges  Challenge[]

  @@map("categories")
}

model Challenge {
  id               String     @id @default(uuid()) @db.Uuid
  categoryId       String     @map("category_id") @db.Uuid
  title            String     @db.VarChar(200)
  track            Track
  difficultyLevel  Difficulty @map("difficulty_level")
  baseXp           Int        @default(10) @map("base_xp")
  orderIndex       Int        @default(0) @map("order_index")
  payloadConfig    Json       @map("payload_config")
  solution         Json
  explanationGuide String     @map("explanation_guide")
  isActive         Boolean    @default(true) @map("is_active")
  // Los retos de diagnóstico no aparecen en la práctica: solo se usan en el diagnóstico inicial y la evaluación final.
  isDiagnostic     Boolean    @default(false) @map("is_diagnostic")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attempts Attempt[]

  @@index([track], map: "idx_challenges_track")
  @@map("challenges")
}

model Attempt {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  challengeId      String       @map("challenge_id") @db.Uuid
  isSuccessful     Boolean      @map("is_successful")
  responsePayload  Json         @map("response_payload")
  timeTakenSeconds Int          @map("time_taken_seconds")
  phase            AttemptPhase @default(PRACTICE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@index([userId], map: "idx_attempts_user")
  @@index([challengeId], map: "idx_attempts_challenge")
  @@map("attempts")
}

// Un refresh token de un solo uso por fila. `familyId` agrupa la cadena de rotaciones de una sesión.
model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

// Configuración simple clave-valor. Hoy guarda la fase del piloto (pilot_phase).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

// Cuestionario de usabilidad SUS (10 afirmaciones, escala 1-5). Una respuesta por persona; en los
// reportes solo se publican agregados.
model SusResponse {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  answers   Int[]
  score     Float
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sus_responses")
}
